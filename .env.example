# Replit provisions DATABASE_URL automatically when you add a PostgreSQL database.
# On-premises: point this at the internal PostgreSQL server.
DATABASE_URL=postgresql://app:app@localhost:5432/ceo_platform
SESSION_SECRET=change-this-to-a-long-random-string
PORT=5000

# --- production / on-premises (see docs/DEPLOYMENT-ONPREM.md) ---
# NODE_ENV=production
# DISABLE_ROLE_SWITCH=true      # hide demo role tabs & demo accounts
# SECURITY_HEADERS=strict       # same-origin CSP, X-Frame-Options, HSTS
# COOKIE_SECURE=true            # HTTPS only
# APP_VERSION=1.0.0
# ADMIN_USERNAME=admin          # used by: npm run db:seed -- --reference-only
# ADMIN_PASSWORD=change-me-12+chars
